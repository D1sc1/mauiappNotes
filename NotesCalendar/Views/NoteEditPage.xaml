<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NotesCalendar.Views.NoteEditPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NotesCalendar.Models"
             xmlns:vm="clr-namespace:NotesCalendar.ViewModels"
             x:DataType="vm:NoteEditViewModel"
             Title="{Binding PageTitle}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Сохранить" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="8">

            <Label Text="Заголовок" Style="{StaticResource SectionLabel}" />
            <Entry Text="{Binding Title}" Placeholder="Что запомнить?" ReturnType="Next" />

            <Label Text="Текст" Style="{StaticResource SectionLabel}" />
            <Editor Text="{Binding Content}" Placeholder="Подробности заметки" HeightRequest="180" />

            <Label Text="Цвет метки" Style="{StaticResource SectionLabel}" />
            <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ColorOptions}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ColorOption">
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{Binding Fill}"
                                Stroke="Transparent" StrokeShape="RoundRectangle 17"
                                SemanticProperties.Description="{Binding Name}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NoteEditViewModel}}, Path=SelectColorCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="✓" TextColor="White" FontAttributes="Bold" FontSize="18"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   IsVisible="{Binding IsSelected}" />
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>

            <Label Text="Дата" Style="{StaticResource SectionLabel}" />
            <DatePicker Date="{Binding Date}" Format="dd MMMM yyyy" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Указать время" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding HasTime}" />
            </Grid>
            <TimePicker Time="{Binding Time}" Format="HH:mm" IsVisible="{Binding HasTime}" />

            <Button Text="Сохранить" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    Command="{Binding SaveCommand}" />
            <Button Text="Удалить" Style="{StaticResource DangerButton}"
                    Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
